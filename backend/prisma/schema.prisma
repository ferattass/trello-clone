generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  emailVerified Boolean @default(false)
  createdAt DateTime @default(now())

  ownedProjects   Project[]       @relation("ProjectOwner")
  memberships     ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  ownedTeams      Team[]          @relation("TeamOwner")
  teamMemberships TeamMember[]
  comments        Comment[]
  notifications   Notification[]
  activities      Activity[]
  authTokens      AuthToken[]
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  ownerId     Int
  createdAt   DateTime @default(now())

  owner    User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members  TeamMember[]
  projects Project[]
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  userId    Int
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  ownerId     Int
  teamId      Int?
  createdAt   DateTime @default(now())

  owner      User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  team       Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members    ProjectMember[]
  columns    Column[]
  tasks      Task[]
  labels     Label[]
  activities Activity[]
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Column {
  id        Int      @id @default(autoincrement())
  name      String
  position  Int
  projectId Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("columns")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  position    Int
  columnId    Int
  projectId   Int
  assigneeId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  column    Column          @relation(fields: [columnId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  labels    TaskLabel[]
  comments  Comment[]
  checklist ChecklistItem[]
}

model Label {
  id        Int      @id @default(autoincrement())
  name      String
  color     String
  projectId Int
  createdAt DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]
}

model TaskLabel {
  id      Int @id @default(autoincrement())
  taskId  Int
  labelId Int

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  taskId    Int
  userId    Int
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id        Int      @id @default(autoincrement())
  text      String
  done      Boolean  @default(false)
  position  Int
  taskId    Int
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Activity {
  id        Int      @id @default(autoincrement())
  action    String
  projectId Int
  userId    Int
  taskId    Int?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  text      String
  link      String?
  read      Boolean  @default(false)
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  type      TokenType
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Mail (SMTP) ayarlari — tek satirlik (id=1) yapilandirma. Admin panelinden
// duzenlenir; enabled+host doluysa mailler gercekten gonderilir.
model MailSetting {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  host      String   @default("")
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String   @default("")
  password  String   @default("")
  fromName  String   @default("Flowboard")
  fromEmail String   @default("no-reply@flowboard.local")
  updatedAt DateTime @updatedAt
}

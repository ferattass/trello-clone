DATABASE_URL="postgresql://postgres:password@localhost:5432/trelloclone?schema=public"
JWT_SECRET="buraya_uzun_ve_rastgele_bir_deger_yaz"
PORT=4000

# Izin verilen frontend adres(ler)i (CORS). Bos birakilirsa herkese acik olur
# (gelistirme). Production'da Vercel adresini yaz:
#   CLIENT_URL="https://uygulaman.vercel.app"
CLIENT_URL=

# Uygulama adresi (mail baglantilarinda kullanilir). Production'da frontend'in
# canli adresi olmali (mail linkleri buna gore uretilir), orn Vercel adresi.
APP_URL="http://localhost:5173"

# Mail gonderen adi/adresi
MAIL_FROM="Flowboard <no-reply@flowboard.local>"

# SMTP ayarlari (opsiyonel). Bos birakilirsa mailler gercekten gonderilmez,
# icerikleri backend konsoluna yazilir (gelistirme modu). Gercek mail icin
# ornegin Gmail SMTP bilgilerini doldur.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
